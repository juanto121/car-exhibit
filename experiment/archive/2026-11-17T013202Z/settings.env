# Fill in your OpenRouter API key. This file stays on your computer; do not share or commit it.
OPENROUTER_API_KEY=<removed>

# Models under test (OpenRouter IDs), reasoning effort, and the provider each is pinned to.
OPENAI_MODEL=openai/gpt-6.1-sol
OPENAI_EFFORT=medium
OPENAI_ROUTE=openai
ANTHROPIC_MODEL=anthropic/claude-opus-5.5
ANTHROPIC_EFFORT=medium
ANTHROPIC_ROUTE=anthropic

# Model-as-judge (scores every saved report; not told which model wrote it).
JUDGE_MODEL=anthropic/claude-opus-5.5
JUDGE_EFFORT=medium
JUDGE_ROUTE=anthropic

# Batch prices in USD per 1M tokens (OpenRouter Batch API, half the sync price),
# used only for the pre-run estimate. After a run, costs come from what OpenRouter billed.
OPENAI_PRICE_IN=1.00
OPENAI_PRICE_OUT=5.00
ANTHROPIC_PRICE_IN=2.00
ANTHROPIC_PRICE_OUT=10.00
JUDGE_PRICE_IN=2.00
JUDGE_PRICE_OUT=10.00
